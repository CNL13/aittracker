# Sao chep file nay thanh .env.local va dien thong tin tu Supabase Dashboard
# KHONG commit file .env.local len git

# Supabase Settings → API → Project URL
SUPABASE_URL=https://XXXX.supabase.co

# Supabase Settings → API → service_role key (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Settings → Database → Connection string (URI mode)
# Thay [YOUR-PASSWORD] bang mat khau database ban dat khi tao project
DATABASE_URL=postgres://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
